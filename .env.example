PORT=4001
HOST=127.0.0.1
NODE_ENV=development

# Strong random values in production (required)
JWT_SECRET=change-me-local-dev
JWT_REFRESH_SECRET=change-me-refresh-local-dev
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Local frontend origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:4001
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_QUOTE_EMAIL=bosco.intertrade@outlook.com

# First admin on a fresh DB (or use: npm run create-admin -- email password "Name")
ADMIN_EMAIL=
ADMIN_PASSWORD=

SMTP_FROM=bosco.intertrade@outlook.com
SMTP_FROM_NAME=Bosco International Trade

# Mail (Brevo recommended): https://www.brevo.com
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# Optional: RESEND_API_KEY=
# Optional Microsoft Graph:
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT_ID=consumers
# MICROSOFT_REFRESH_TOKEN=

# ---------- Production frontend (Vite build) ----------
# VITE_API_URL=https://api.your-domain.com/api
# Do NOT set VITE_STATIC_API=true when the real API is live.
